# Copy this file to .env in the LeenPlaats/ directory (next to LeenPlaats.sln)
# Values here override appsettings.json — use __ to separate config sections

# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=leenplaats;User=root;Password=;AllowPublicKeyRetrieval=true;

# JWT — generate a strong secret: openssl rand -base64 32
Jwt__Secret=change-this-to-a-long-random-secret-key-min-32-chars
Jwt__Issuer=LeenPlaats
Jwt__Audience=LeenPlaats
Jwt__ExpirationDays=30

# CORS — comma-separated list of allowed Blazor client origins
AllowedOrigins=http://localhost:5167,https://localhost:7154
