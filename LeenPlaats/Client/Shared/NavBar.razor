@inject NavigationManager Nav
@inject AuthService Auth

<nav class="bottom-nav">
    <button class="nav-item @ActiveClass("/")" @onclick='() => Nav.NavigateTo("/")'>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
        </svg>
        <span>Zoeken</span>
    </button>

    <button class="nav-item nav-item--center" @onclick="OnPlaceAdClicked">
        <div class="nav-plus">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
        </div>
        <span>Plaatsen</span>
    </button>

    <button class="nav-item @ActiveClass("/mijn")" @onclick="NavigateMijn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Mijn</span>
    </button>
</nav>

@code {
    [Parameter] public EventCallback OnPlaceAdClicked { get; set; }

    private string ActiveClass(string path) =>
        Nav.Uri.EndsWith(path) ? "nav-item--active" : "";

    private void NavigateMijn()
    {
        Nav.NavigateTo(Auth.IsAuthenticated ? "/mijn" : "/login");
    }
}
