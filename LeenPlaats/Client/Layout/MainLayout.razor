@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject AuthService Auth

<div class="app-shell">
    <main class="app-content">
        @Body
    </main>
    <NavBar OnPlaceAdClicked="OpenPlaceAd" />
</div>

<PlaceAd IsOpen="@_placeAdOpen" OnClose="ClosePlaceAd" />

@code {
    private bool _placeAdOpen;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
    }

    private void OpenPlaceAd() => _placeAdOpen = true;
    private void ClosePlaceAd() => _placeAdOpen = false;
}
